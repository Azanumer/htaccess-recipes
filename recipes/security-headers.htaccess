# Security headers: blocks clickjacking, MIME sniffing, and most XSS reflection
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Only enable HSTS once you are sure HTTPS works everywhere on the domain
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Hide server version & PHP signatures
ServerTokens Prod
<IfModule mod_php.c>
    php_flag expose_php Off
</IfModule>

# Block access to sensitive files
<FilesMatch "^(wp-config\.php|\.htaccess|\.htpasswd|readme\.html|xmlrpc\.php)$">
    Require all denied
</FilesMatch>
